{
  "expo": {
    "name": "RateDeed",
    "slug": "ratedeed",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./icon.png",
    "newArchEnabled": true,
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "buildNumber": "28",
      "supportsTablet": true,
      "bundleIdentifier": "com.ratedeed.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "fetch",
          "remote-notification"
        ],
        "NSMicrophoneUsageDescription": "Allow RateDeed to access your microphone to record voice messages and videos."
      },
      "googleServicesFile": "./GoogleService-Info.plist",
      "splash": {
        "image": "./assets/splash.png",
        "resizeMode": "contain",
        "backgroundColor": "#ffffff"
      }
    },
    "android": {
      "versionCode": 28,
      "adaptiveIcon": {
        "foregroundImage": "./icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.ratedeed.app",
      "googleServicesFile": "./google-services.json",
      "splash": {
        "image": "./assets/splash.png",
        "resizeMode": "contain",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./icon.png"
    },
    "plugins": [
      "@react-native-firebase/app",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://us.sentry.io/",
          "organization": "ratedeed",
          "project": "ratedeed-mobile",
          "setCommits": false,
          "uploadSourceMaps": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow RateDeed to access your camera for profile pictures and post images."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow RateDeed to access your photos for profile pictures and post images."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./icon.png",
          "color": "#ffffff"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "compilerFlags": "-DFMT_CONSTEXPR=constexpr"
          }
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.ratedeed.app",
          "enableApplePay": true
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "Allow RateDeed to use your data to provide a better, more personalized experience and for analytics."
        }
      ]
    ],
    "scheme": "ratedeed",
    "extra": {
      "eas": {
        "projectId": "db15905a-a695-4ad4-b95a-0f2a762b193b"
      },
      "sentryDsn": "https://9551400459289c85e05f957e50a65941@o4511186039603200.ingest.us.sentry.io/4511186048843776"
    },
    "owner": "ratedeeds-organization",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/db15905a-a695-4ad4-b95a-0f2a762b193b"
    }
  }
}
